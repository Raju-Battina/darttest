@model string?

@{
    ViewData["Title"] = "Page not found";
}

<div class="text-center py-5">
    <p class="text-muted display-6">404</p>
    <h1 class="mb-3">Page not found</h1>
    <p class="lead text-muted">We could not find the page you requested.</p>

    @if (!string.IsNullOrWhiteSpace(Model))
    {
        <p class="text-muted"><code>@Model</code></p>
    }

    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Back to weather data</a>
</div>
